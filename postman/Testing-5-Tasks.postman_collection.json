      "name": "Task 5 - Redis Caching",
      "item": [
        {
          "name": "First Request (Cache Miss)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response returns user data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.exist;",
                  "});",
                  "",
                  "var responseTime1 = pm.response.responseTime;",
                  "pm.environment.set('response_time_1', responseTime1);",
                  "console.log('First request (cache miss):', responseTime1, 'ms');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            },
            "description": "First request - cache miss, data from database"
          },
          "response": []
        },
        {
          "name": "Second Request (Cache Hit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response returns cached user data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.exist;",
                  "});",
                  "",
                  "var responseTime2 = pm.response.responseTime;",
                  "var responseTime1 = pm.environment.get('response_time_1');",
                  "",
                  "pm.test(\"Cache hit is faster than cache miss\", function () {",
                  "    pm.expect(responseTime2).to.be.below(responseTime1 * 2);",
                  "});",
                  "",
                  "console.log('Second request (cache hit):', responseTime2, 'ms');",
                  "console.log('Performance improvement:', ((responseTime1 - responseTime2) / responseTime1 * 100).toFixed(2), '%');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            },
            "description": "Second request - cache hit, data from Redis"
          },
          "response": []
        },
