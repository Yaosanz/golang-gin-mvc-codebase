    {
      "name": "Task 2 - RBAC Token Payload",
      "description": "Verifikasi struktur token payload berisi semua informasi yang dibutuhkan untuk RBAC (Role-Based Access Control) seperti user_id, username, email, dan roles.",
      "item": [
        {
          "name": "✅ VALID: Cek Token Payload Structure",
          "description": "Akses profile dengan token valid. Verifikasi payload berisi user_id, username, email, roles. Status: 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 200 - Token valid', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('✅ Payload berisi user_id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.exist;",
                  "    console.log('User ID:', jsonData.data.id);",
                  "});",
                  "",
                  "pm.test('✅ Payload berisi username', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.username).to.exist;",
                  "});",
                  "",
                  "pm.test('✅ Payload berisi email', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.email).to.exist;",
                  "});",
                  "",
                  "pm.test('✅ Payload berisi roles (RBAC)', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.roles).to.be.an('array');",
                  "    console.log('RBAC Roles:', jsonData.data.roles);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            }
          },
          "response": []
        },
        {
