{
  "info": {
    "_postman_id": "test-5-tasks-improved-2026",
    "name": "Testing 5 Core Implementation Tasks (Improved)",
    "description": "Testing Suite Komprehensif untuk 5 Core Implementation Tasks\n\n1️⃣ TASK 1: JWT Multi-Role Auth - Test registrasi user dan login untuk mendapatkan JWT token\n2️⃣ TASK 2: RBAC Token Payload - Verifikasi struktur token payload berisi user_id, username, email, dan roles\n3️⃣ TASK 3: Middleware Token Identification - Test middleware dengan token VALID vs INVALID, missing header, invalid format, expired token\n4️⃣ TASK 4: Database Transactions - Test transaction commit (success) dan rollback (duplicate user)\n5️⃣ TASK 5: Redis Caching - Test cache hit/miss, invalidation, dan TTL configuration\n\nSetiap test menunjukkan perbedaan antara request yang valid dan invalid.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Task 1 - JWT Multi-Role Auth",
      "description": "Test JWT authentication dengan multi-role support. User dapat memiliki multiple roles dan token JWT berisi informasi role tersebut.",
      "item": [
        {
          "name": "✅ VALID: Register User Baru",
          "description": "Register user baru dengan credentials valid untuk testing. Status yang diharapkan: 201 Created",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 201 - User berhasil terdaftar', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('✅ Response berisi success message', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test User Multi Role\",\n    \"username\": \"testmultirole\",\n    \"email\": \"testmultirole@example.com\",\n    \"password\": \"SecurePass123!\",\n    \"phone\": \"+628123456789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "❌ INVALID: Registrasi User Duplikat",
          "description": "Coba register dengan username/email yang sudah ada. Status yang diharapkan: 409 Conflict (bukan 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('❌ Status code 409 - Duplicate user ditolak', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('❌ Response berisi error message tentang username/email exists', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error || jsonData.message).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Test User Multi Role - Duplicate\",\n    \"username\": \"testmultirole\",\n    \"email\": \"testmultirole@example.com\",\n    \"password\": \"SecurePass123!\",\n    \"phone\": \"+628123456789\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "✅ VALID: Login dan Dapatkan JWT Token",
          "description": "Login dengan username dan password yang valid. Sistem akan mengembalikan JWT token yang berisi user info dan roles. Status: 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 200 - Login berhasil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('✅ Response berisi JWT token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "    pm.environment.set('auth_token', jsonData.data.token);",
                  "});",
                  "",
                  "pm.test('✅ Token payload berisi roles array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.user.roles).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
