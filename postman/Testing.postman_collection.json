    {
      "name": "Task 3 - Middleware Token Identification",
      "description": "Test middleware authentication dengan berbagai scenario: token VALID, INVALID, MISSING, format salah, dan EXPIRED. Lihat perbedaan respons untuk setiap case.",
      "item": [
        {
          "name": "✅ VALID: Bearer Token Format Benar",
          "description": "Request dengan Authorization header format yang benar (Bearer <token>). Status: 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 200 - Valid Bearer token diterima', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('✅ Middleware menerima token format yang benar', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "description": "Bearer token format yang VALID"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "❌ INVALID: Authorization Header Hilang",
          "description": "Request TANPA Authorization header. Middleware harus menolak. Status: 401 Unauthorized (bukan 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('❌ Status code 401 - Header Authorization tidak ada ditolak', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('❌ Response berisi error message', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "❌ INVALID: Format Bearer Salah",
          "description": "Request dengan format Authorization header yang SALAH (bukan Bearer format). Middleware harus menolak. Status: 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('❌ Status code 401 - Format Bearer salah ditolak', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('❌ Middleware validasi format Bearer ketat', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "InvalidFormat token123",
                "description": "Format SALAH - bukan Bearer"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "❌ INVALID: Token Kadaluarsa",
          "description": "Request dengan token yang sudah expired. Middleware harus menolak. Status: 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('❌ Status code 401 - Expired token ditolak', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('❌ Middleware validasi token expiration', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE2MDAwMDAwMDB9.EXPIRED_TOKEN_EXAMPLE",
                "description": "Token yang sudah kadaluarsa"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Task 4 - Database Transactions",
      "description": "Test database transaction handling: commit ketika berhasil, rollback ketika ada error (duplicate user). Verifikasi data consistency.",
      "item": [
        {
          "name": "✅ VALID: User Baru - Transaction Commit Success",
          "description": "Create user baru dengan data valid. Database transaction harus COMMIT. Status: 201 Created",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 201 - User berhasil dibuat', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('✅ Transaction berhasil COMMIT ke database', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('success');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Transaction Test User\",\n    \"username\": \"transactiontest\",\n    \"email\": \"transaction@example.com\",\n    \"password\": \"SecurePass123!\",\n    \"phone\": \"+628987654321\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "❌ INVALID: Duplicate User - Transaction Rollback",
          "description": "Coba create user dengan username/email DUPLIKAT. Transaction harus ROLLBACK. Status: 409 Conflict (bukan 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('❌ Status code 409 - Duplicate user ditolak', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('❌ Transaction ROLLBACK karena constraint violation', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error || jsonData.message).to.include('already exists');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Duplicate Transaction Test\",\n    \"username\": \"transactiontest\",\n    \"email\": \"transaction@example.com\",\n    \"password\": \"SecurePass123!\",\n    \"phone\": \"+628987654321\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "✅ VALID: Update User Profile - Transaction dengan Context",
          "description": "Update profile user yang login. Transaction dengan context (user_id dari JWT). Status: 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 200 - Update berhasil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('✅ Transaction COMMIT dengan context user_id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.include('success');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Updated Name\",\n    \"phone\": \"+628111111111\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users",
              "host": ["{{base_url}}"],
              "path": ["api", "users"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Task 5 - Redis Caching",
      "description": "Test Redis caching: cache hit/miss, invalidation on update, dan TTL (Time To Live) configuration untuk berbagai resource.",
      "item": [
        {
          "name": "🔐 Admin Login untuk Cache Testing",
          "description": "Login dengan akun admin untuk testing caching operations. Admin punya akses ke semua resources.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 200 - Login admin berhasil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('✅ Dapatkan admin token untuk cache testing', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "    pm.environment.set('auth_token', jsonData.data.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "✅ Cache MISS: First Request - Data dari Database",
          "description": "Request pertama ke endpoint. Redis cache kosong, data diambil dari database. Akan lebih lambat. Status: 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 200 - Data berhasil diambil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('✅ Cache MISS - Data dari database (lebih lambat)', function () {",
                  "    var responseTime1 = pm.response.responseTime;",
                  "    pm.environment.set('response_time_1', responseTime1);",
                  "    console.log('First request (cache miss):', responseTime1, 'ms');",
                  "});",
                  "",
                  "pm.test('✅ Response berisi user data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "profile"]
            }
          },
          "response": []
        },
        {
          "name": "⚡ Cache HIT: Second Request - Data dari Redis Cache",
          "description": "Request kedua ke endpoint yang sama. Data sudah di-cache di Redis, response lebih cepat. Status: 200 OK",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('✅ Status code 200 - Data dari cache', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('✅ Cache HIT - Data dari Redis (lebih cepat)', function () {",
                  "    var responseTime2 = pm.response.responseTime;",
                  "    var responseTime1 = pm.environment.get('response_time_1');",
                  "    pm.environment.set('response_time_2', responseTime2);",
                  "    console.log('Second request (cache hit):', responseTime2, 'ms');",
                  "    console.log('Performance improvement:', ((responseTime1 - responseTime2) / responseTime1 * 100).toFixed(2), '%');",
                  "});",
                  "",
                  "pm.test('✅ Response berisi cached user data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/profile",
              "host": ["{{base_url}}"],
